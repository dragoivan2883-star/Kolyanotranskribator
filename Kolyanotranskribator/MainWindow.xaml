<Window x:Class="Kolyanotranskribator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="K. I. T." Width="800" Height="570" MinWidth="680" MinHeight="470"
        Background="#08090B" Foreground="#F3F3F4" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <LinearGradientBrush x:Key="Gloss" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#33363C" Offset="0"/>
            <GradientStop Color="#1A1C21" Offset="0.18"/>
            <GradientStop Color="#101115" Offset="0.62"/>
            <GradientStop Color="#090A0D" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#34363B"/>
            <Setter Property="Background" Value="#202227"/>
            <Setter Property="Foreground" Value="#ECEDEF"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.83"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource Gloss}" BorderBrush="#3A3C42" BorderThickness="1" CornerRadius="16" Padding="26,20" Margin="0,0,0,23">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="K. I. T." FontFamily="Bahnschrift" FontSize="36" FontWeight="SemiBold"/>
                    <TextBlock Text="Локальная транскрибация" Foreground="#A4A7AC" FontSize="13" Margin="1,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Width="9" Height="9" CornerRadius="5" Background="#D8363C" VerticalAlignment="Top" Margin="0,5,0,0"/>
            </Grid>
        </Border>
        <TextBlock Grid.Row="1" Text="Положите аудио или видео во Входящие и запустите обработку." Foreground="#AFB1B6" FontSize="14" Margin="2,0,0,19"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,22">
            <Button x:Name="ProcessButton" Content="Обработать входящие" Background="#C92F37" BorderBrush="#E24A50" Foreground="White" Click="ProcessClick" Margin="0,0,11,0"/>
            <Button Content="Открыть Входящие" Click="OpenIncomingClick" Margin="0,0,11,0"/>
            <Button Content="Открыть Исходящие" Click="OpenOutgoingClick"/>
        </StackPanel>
        <Border Grid.Row="3" Background="#131519" BorderBrush="#303239" BorderThickness="1" CornerRadius="14" Padding="21">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Ход работы" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,13,0,15" Text="Готово к обработке" TextWrapping="Wrap" Foreground="#B8BBC0"/>
                <ListBox x:Name="ResultsList" Grid.Row="2" BorderThickness="0" Background="Transparent" Foreground="#DEE0E3" FontSize="13"/>
            </Grid>
        </Border>
        <Grid Grid.Row="4" Height="28" Margin="1,11,1,0">
            <TextBlock Text="Звук обрабатывается на этом компьютере" Foreground="#777B82" FontSize="11" VerticalAlignment="Center"/>
            <Border x:Name="ProcessingIndicator" Visibility="Collapsed" Background="#151518" ClipToBounds="True" CornerRadius="3" Height="6" VerticalAlignment="Center">
                <Path Stroke="#ED3942" StrokeThickness="4" StrokeDashArray="7 5" Data="M 0,3 L 1200,3">
                    <Path.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-24" Duration="0:0:0.8"/>
                        </Storyboard>
                    </BeginStoryboard></EventTrigger></Path.Triggers>
                </Path>
            </Border>
        </Grid>
    </Grid>
</Window>
