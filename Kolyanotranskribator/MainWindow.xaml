<Window x:Class="Kolyanotranskribator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="K. I. T." Width="920" Height="650" MinWidth="760" MinHeight="560"
        Background="#050608" Foreground="#F0F1F2" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <LinearGradientBrush x:Key="Paint" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#353941" Offset="0"/>
            <GradientStop Color="#15181E" Offset="0.28"/>
            <GradientStop Color="#080A0D" Offset="0.66"/>
            <GradientStop Color="#171A20" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonPaint" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2D3037" Offset="0"/>
            <GradientStop Color="#15171C" Offset="0.45"/>
            <GradientStop Color="#0B0D11" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#4A4D54"/>
            <Setter Property="Background" Value="{StaticResource ButtonPaint}"/>
            <Setter Property="Foreground" Value="#F0F1F2"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#EB3B42"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.42"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="194"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Paint}" BorderBrush="#4A4E56" BorderThickness="1"
                CornerRadius="7" Margin="0,0,0,22" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="26,27,0,0" Panel.ZIndex="1">
                    <TextBlock Text="K. I. T." FontFamily="Bahnschrift" FontWeight="SemiBold" FontSize="42" Foreground="#F3F4F6"/>
                    <Rectangle Height="3" Width="78" Fill="#E62F39" HorizontalAlignment="Left" Margin="2,6,0,13"/>
                    <TextBlock Text="Транскрибация аудио и видео" FontSize="13" Foreground="#A9ADB4"/>
                </StackPanel>
                <Viewbox Grid.Column="1" Stretch="Uniform" HorizontalAlignment="Stretch" Margin="0,4,12,0">
                    <Canvas Width="650" Height="176">
                        <Path Data="M 55,98 L 132,48 Q 325,6 518,48 L 595,98 L 626,139 Q 325,171 24,139 Z"
                              Fill="#030405" Stroke="#555B64" StrokeThickness="2"/>
                        <Path Data="M 127,51 Q 325,10 523,51 L 550,75 Q 325,93 100,75 Z"
                              Fill="#11151A" Stroke="#303741" StrokeThickness="1"/>
                        <Path Data="M 158,49 Q 325,20 492,49 L 505,65 Q 325,75 145,65 Z"
                              Fill="#1E2630" Opacity="0.8"/>
                        <Path Data="M 65,98 Q 325,120 585,98 L 615,130 Q 325,157 35,130 Z"
                              Fill="#101216" Stroke="#363A42" StrokeThickness="1"/>
                        <Path Data="M 89,90 L 197,101 L 181,112 L 70,107 Z" Fill="#88939A" Opacity="0.78"/>
                        <Path Data="M 561,90 L 453,101 L 469,112 L 580,107 Z" Fill="#88939A" Opacity="0.78"/>
                        <Path Data="M 83,95 L 177,104 M 567,95 L 473,104" Stroke="#D6DCE0" StrokeThickness="2" Opacity="0.7"/>
                        <Border Canvas.Left="216" Canvas.Top="112" Width="218" Height="19" Background="#020303"
                                BorderBrush="#515158" BorderThickness="1" CornerRadius="4"/>
                        <Rectangle Canvas.Left="224" Canvas.Top="119" Width="202" Height="5" Fill="#752029"/>
                        <Rectangle Canvas.Left="224" Canvas.Top="119" Width="202" Height="3" Fill="#EB3942" Opacity="0.62"/>
                        <Rectangle x:Name="ScannerSweep" Visibility="Collapsed" Canvas.Left="224" Canvas.Top="115"
                                   Width="44" Height="13" Fill="#FF3D45" Opacity="0.95">
                            <Rectangle.Effect><BlurEffect Radius="11"/></Rectangle.Effect>
                            <Rectangle.RenderTransform><TranslateTransform/></Rectangle.RenderTransform>
                            <Rectangle.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                     From="0" To="158" Duration="0:0:0.85"/>
                                </Storyboard>
                            </BeginStoryboard></EventTrigger></Rectangle.Triggers>
                        </Rectangle>
                        <Path Data="M 32,143 Q 325,170 618,143" Stroke="#666B70" StrokeThickness="2" Opacity="0.56"/>
                        <Path Data="M 180,39 Q 325,9 470,39" Stroke="#FFFFFF" StrokeThickness="2" Opacity="0.18"/>
                    </Canvas>
                </Viewbox>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Text="Положите аудио или видео во Входящие и запустите обработку."
                   Foreground="#B5B8BE" FontSize="14" Margin="2,0,0,18"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,19">
            <Button x:Name="ProcessButton" Content="Обработать входящие" Background="#9F1D27"
                    BorderBrush="#EC4048" Foreground="White" Click="ProcessClick" Margin="0,0,11,0"/>
            <Button Content="Открыть Входящие" Click="OpenIncomingClick" Margin="0,0,11,0"/>
            <Button Content="Открыть Исходящие" Click="OpenOutgoingClick"/>
        </StackPanel>

        <Border Grid.Row="3" Background="#101216" BorderBrush="#353942" BorderThickness="1" CornerRadius="6" Padding="20">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel>
                    <Rectangle Width="4" Height="16" Fill="#E7353E" DockPanel.Dock="Left" Margin="0,1,10,0"/>
                    <TextBlock Text="Ход работы" FontFamily="Bahnschrift" FontSize="17" FontWeight="SemiBold"/>
                </DockPanel>
                <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,15,0,13" Text="Готово к обработке"
                           TextWrapping="Wrap" Foreground="#C7CAD0" FontFamily="Consolas" FontSize="12"/>
                <ListBox x:Name="ResultsList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                         Foreground="#D8DADF" FontFamily="Consolas" FontSize="12"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Height="32" Margin="1,9,1,0">
            <TextBlock Text="Обработка выполняется на этом компьютере" Foreground="#80848C"
                       FontSize="11" VerticalAlignment="Center"/>
            <Border x:Name="ProcessingIndicator" Visibility="Collapsed" Background="#100709"
                    ClipToBounds="True" Height="7" VerticalAlignment="Center">
                <Path Stroke="#F13941" StrokeThickness="4" StrokeDashArray="7 5" Data="M 0,3 L 1500,3">
                    <Path.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-24" Duration="0:0:0.8"/>
                        </Storyboard>
                    </BeginStoryboard></EventTrigger></Path.Triggers>
                </Path>
            </Border>
        </Grid>
    </Grid>
</Window>
